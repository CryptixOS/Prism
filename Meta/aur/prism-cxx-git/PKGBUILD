# Maintainer: Szymon Zemke <v1tr10l7@proton.me>
#
# Published to the AUR by .github/workflows/aur.yml after CI passes on master.
# Edit this file, not the copy on the AUR.

pkgname=prism-cxx-git
_pkgname=prism
pkgver=r0.0000000
pkgrel=1
pkgdesc="Freestanding C++23 standard library and runtime for kernel-space development (CryptixOS)"
arch=('x86_64' 'aarch64')
url="https://github.com/CryptixOS/Prism"
license=('GPL-2.0-or-later' 'MIT' 'Apache-2.0')
# Host builds use the system fmt; Prism's public headers include it.
depends=('fmt')
makedepends=('git' 'cmake' 'ninja')
optdepends=('clang: C++23 compiler for building against Prism (or gcc)')
provides=('prism-cxx')
conflicts=('prism-cxx')
# libprism.a is a static library: keep it, and don't LTO it.
options=('staticlibs' '!lto')

# Bundled dependencies are listed here so the build never touches the network.
_magic_enum=magic_enum-v0.9.5
source=("${_pkgname}::git+https://github.com/CryptixOS/Prism.git"
        "demangler::git+https://github.com/ilobilo/demangler.git"
        "${_magic_enum}.tar.gz::https://github.com/Neargye/magic_enum/releases/download/v0.9.5/${_magic_enum}.tar.gz")
noextract=("${_magic_enum}.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            '0694e1ef160cbb6b8be2f43c7df349295911cb7daebdd4e557adaac2c18420f9')

pkgver() {
  cd "${_pkgname}"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  # CMake picks bundled dependencies up from subprojects/ when present.
  cd "${_pkgname}/subprojects"
  rm -rf demangler magic_enum
  cp -a "${srcdir}/demangler" demangler
  mkdir magic_enum
  bsdtar -xf "${srcdir}/${_magic_enum}.tar.gz" -C magic_enum
}

build() {
  # Install into private directories: Prism ships its own magic_enum, which
  # must not clash with the system package.
  cmake -S "${_pkgname}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_INCLUDEDIR=include/prism-cxx \
    -DCMAKE_INSTALL_LIBDIR=lib/prism-cxx \
    -DPRISM_INSTALL_CMAKEDIR=lib/cmake/Prism \
    -DPRISM_INSTALL_PKGCONFIGDIR=lib/pkgconfig \
    -DPRISM_PKGCONFIG_NAME=prism-cxx \
    -DPRISM_TARGET=app \
    -DPRISM_BUILD_TESTS=ON \
    -DPRISM_WERROR=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 "${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_pkgname}/subprojects/magic_enum/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.magic_enum"
  install -Dm644 "${_pkgname}/subprojects/demangler/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.demangler"
}
