// Generated by the build (CMakeLists.txt, meson.build) from Version.ixx.in.
module;

#include <Prism/Core/Types.hpp>

#mesondefine PM_VERSION_MAJOR
#mesondefine PM_VERSION_MINOR
#mesondefine PM_VERSION_PATCH

export module Prism.Core.Version;

export import Prism.String.Formatter;
export import Prism.String.String;

export extern "C++"
{
namespace Prism
{
    struct Version
    {
        u16 Major           = 0;
        u16 Minor           = 0;
        u16 Patch           = 0;

        constexpr Version() = default;
        constexpr Version(u16 major, u16 minor, u16 patch)
            : Major(major)
            , Minor(minor)
            , Patch(patch)
        {
        }

        constexpr operator u64() const
        {
            return (static_cast<u64>(Major) << 48)
                 | (static_cast<u64>(Minor) << 32)
                 | (static_cast<u64>(Patch) << 16ull);
        }
        explicit operator String() const
        {
            return Format("{}.{}.{}", Major, Minor, Patch);
        }
    };

    inline constexpr StringView LIBRARY_NAME = "@library_name@";

    inline constexpr Version VERSION
        = {PM_VERSION_MAJOR, PM_VERSION_MINOR, PM_VERSION_PATCH};
    inline constexpr StringView GIT_TAG          = "@git_tag@";

    // When the build was configured (a module can't use __DATE__).
    inline constexpr StringView BUILD_DATE       = "@build_date@";
    inline constexpr StringView BUILD_TIME       = "@build_time@";

    inline constexpr StringView ARCH_STRING      = "@arch@";
    inline constexpr StringView COMPILER         = "@compiler@";
    inline constexpr StringView COMPILER_VERSION = "@compiler_version@";

    inline constexpr StringView VERSION_STRING   = "@library_version_string@";
}; // namespace Prism

template <>
struct Prism::Formatter<Prism::Version> : Prism::Formatter<Prism::StringView>
{
    Prism::FormatAppender Format(const Prism::Version& version,
                                 Prism::FormatContext& ctx) const
    {
        char buffer[48];
        auto result = Prism::FormatToN(buffer, sizeof(buffer), "{}.{}.{}",
                                       version.Major, version.Minor,
                                       version.Patch);
        return Prism::Formatter<Prism::StringView>::Format(
            Prism::StringView(buffer, static_cast<Prism::usize>(result.Out - buffer)),
            ctx);
    }
};

#if PRISM_USE_NAMESPACE != 0
using Prism::Version;
#endif
}
